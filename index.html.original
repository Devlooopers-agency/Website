<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="theme-color" content="#ffffff">
  <meta name="description" content="devlooopers — interactive digital products, 3D web experiences and intelligent systems.">
  <title>devlooopers — Digital experiences that move</title>
  <link rel="icon" type="image/png" href="assets/devlooopers-logo-d.png">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="assets/bootstrap.min.css">
  <link rel="stylesheet" href="styles.css">
</head>
<body data-page="home" class="intro-running">
<div class="noise"></div>

<!-- Custom Interactive Magnetic Cursor (Desktop) -->
<div class="custom-cursor" id="customCursor" aria-hidden="true">
  <div class="cursor-dot"></div>
  <div class="cursor-ring">
    <span class="cursor-icon"></span>
    <span class="cursor-label"></span>
  </div>
</div>

<!-- Studio Choreographed 0-5s Intro Stage -->
<div id="studioIntro" class="studio-intro" aria-hidden="true">
  <div class="intro-flying-brand" id="introFlyingBrand">
    <img src="assets/devlooopers-logo-d.png" alt="devlooopers icon" class="intro-brand-icon">
    <img src="assets/devlooopers-logo.png" alt="devlooopers wordmark" class="intro-brand-text">
  </div>
  <div class="intro-click-hint">Click anywhere to skip ↗</div>
</div>

<header class="site-header" id="siteHeader">
  <a class="brand" id="navBrand" href="index.html" aria-label="devlooopers home" data-cursor="HOME">
    <img src="assets/devlooopers-logo-d.png" alt="devlooopers icon" class="brand-logo-icon">
    <img src="assets/devlooopers-logo.png" alt="devlooopers" class="brand-logo-text">
  </a>
  <button class="menu-toggle" aria-label="Open menu" aria-expanded="false"><i></i><i></i></button>
  <nav class="nav" aria-label="Primary">
    <a class="active" href="index.html" data-cursor="HOME">Home</a>
    <a href="work.html" data-cursor="WORK">Work</a>
    <a href="services.html" data-cursor="SERVICES">Services</a>
    <a href="about.html" data-cursor="STUDIO">Studio</a>
    <a class="nav-cta" href="contact.html" data-cursor="START">Start a project <span>↗</span></a>
  </nav>
</header>

<main>
  <section class="hero shell">
    <div class="hero-copy">
      <div class="eyebrow hero-eyebrow">
        <span>DIGITAL STUDIO</span> <i>·</i> <span>DESIGN × CODE × CURIOSITY</span>
      </div>
      <h1 class="display hero-display" aria-label="BUILD THE UNEXPECTED.">
        <span class="line-mask"><span class="line-item line-1">BUILD</span></span>
        <span class="line-mask"><span class="line-item line-2">THE</span></span>
        <span class="line-mask"><span class="line-item line-3 gradient-text">UNEXPECTED.</span></span>
      </h1>
      <p class="hero-lead hero-lead-reveal">We design bold websites, intelligent products and interactive experiences for teams ready to move beyond ordinary.</p>
      <div class="hero-actions hero-actions-reveal">
        <a class="button primary" href="work.html" data-cursor="EXPLORE" data-magnetic="true">Explore our work <span>↗</span></a>
        <a class="text-link" href="contact.html" data-cursor="CONTACT">Tell us what you're building <span>→</span></a>
      </div>
    </div>
    <div class="hero-visual hero-visual-reveal" aria-label="Interactive 3D showcase" data-cursor="EXPLORE" data-cursor-icon="⊕">
      <div class="orbital orbital-1"></div>
      <div class="orbital orbital-2"></div>
      <div class="orbital orbital-3"></div>
      <div class="scene-3d" id="heroScene">
        <canvas id="heroCanvas" width="500" height="500"></canvas>
        <div class="float-card card-one" data-cursor="SHAPE"><span>01</span><b>Shape</b><small>strategy</small></div>
        <div class="float-card card-two" data-cursor="DESIGN"><span>02</span><b>Design</b><small>experience</small></div>
        <div class="float-card card-three" data-cursor="SCALE"><span>03</span><b>Scale</b><small>technology</small></div>
      </div>
      <div class="hero-touch-hint" id="heroTouchHint"><span class="touch-icon">👆</span><span>DRAG ↔ TO ROTATE 3D</span></div>
      <div class="orbit-labels-container">
        <div class="orbit-label label-a">3D / WEBGL</div>
        <div class="orbit-label label-b">UI / UX</div>
        <div class="orbit-label label-c">AI / CODE</div>
      </div>
      <div class="hero-glow"></div>
    </div>
  </section>

  <section class="marquee-wrap" aria-label="Capabilities">
    <div class="marquee"><span>BRAND SYSTEMS</span><b>✦</b><span>PRODUCT DESIGN</span><b>✦</b><span>3D EXPERIENCES</span><b>✦</b><span>AI PRODUCTS</span><b>✦</b><span>FRONTEND ENGINEERING</span><b>✦</b><span>BRAND SYSTEMS</span><b>✦</b><span>PRODUCT DESIGN</span><b>✦</b></div>
  </section>

  <section class="section shell split-section what-we-do-section">
    <div class="section-kicker reveal">01 / WHAT WE DO</div>
    <div class="section-body">
      <div class="what-we-do-head">
        <h2 class="section-title reveal">Ideas are only the <span class="gradient-text">starting point.</span></h2>
        <p class="section-copy reveal delay-1">devlooopers brings strategy, visual design and software engineering into one tight loop. The result is digital work that looks distinctive, behaves beautifully and can actually ship.</p>
      </div>
      
      <!-- Interactive 3D Capabilities Grid -->
      <div class="capability-grid-interactive reveal delay-2" id="interactiveCapabilities">
        
        <!-- 01 / Experience Design -->
        <div class="capability-card-interactive" data-capability="design" data-cursor="EXPERIENCE">
          <div class="cap-glare"></div>
          <button class="cap-accordion-toggle" aria-expanded="false" aria-controls="cap-content-1" id="cap-header-1">
            <div class="cap-header-info">
              <span class="cap-num">01</span>
              <h3 class="cap-title">Experience Design</h3>
            </div>
            <div class="cap-header-meta">
              <div class="cap-live-badge">
                <span class="cap-badge-pulse"></span>
                <span class="cap-badge-text">SPATIAL UX</span>
              </div>
              <span class="cap-accordion-icon" aria-hidden="true">+</span>
            </div>
          </button>

          <div class="cap-expandable-content" id="cap-content-1" role="region" aria-labelledby="cap-header-1">
            <div class="cap-content-inner">
              <div class="cap-micro-stage">
                <div class="cap-bezier-art">
                  <svg viewBox="0 0 220 70" class="cap-svg-canvas" aria-hidden="true">
                    <defs>
                      <linearGradient id="uxCurveGrad" x1="0%" y1="0%" x2="100%" y2="0%">
                        <stop offset="0%" stop-color="#5350d7" />
                        <stop offset="50%" stop-color="#30a1bf" />
                        <stop offset="100%" stop-color="#39cf72" />
                      </linearGradient>
                      <linearGradient id="laserGrad" x1="0%" y1="0%" x2="100%" y2="0%">
                        <stop offset="0%" stop-color="#30a1bf" stop-opacity="0" />
                        <stop offset="75%" stop-color="#39cf72" stop-opacity="0.9" />
                        <stop offset="100%" stop-color="#ffffff" stop-opacity="1" />
                      </linearGradient>
                    </defs>

                    <!-- Background Grid / Wireframe guides -->
                    <g class="cap-grid-guides">
                      <line x1="15" y1="20" x2="205" y2="20" class="cap-grid-line" />
                      <line x1="15" y1="35" x2="205" y2="35" class="cap-grid-line" />
                      <line x1="15" y1="50" x2="205" y2="50" class="cap-grid-line" />
                    </g>

                    <!-- Figma style Control Tangent Handles -->
                    <line x1="20" y1="52" x2="68" y2="16" class="cap-tangent-line tl-1" />
                    <line x1="200" y1="18" x2="152" y2="54" class="cap-tangent-line tl-2" />

                    <!-- Ambient Base Curve -->
                    <path d="M 20 52 C 70 14, 150 56, 200 18" class="cap-curve-base" />

                    <!-- Dynamic Flowing Wave Line (Continuous Gradient Stream) -->
                    <path d="M 20 52 C 70 14, 150 56, 200 18" class="cap-curve-flow" />

                    <!-- Continuous Traveling Laser Pulse -->
                    <path d="M 20 52 C 70 14, 150 56, 200 18" class="cap-curve-pulse" />

                    <!-- UX Nodes with Animated Radar Rings -->
                    <!-- Node 1 (Start UI Anchor) -->
                    <g class="cap-node-point np-1" transform="translate(20, 52)">
                      <circle r="9" class="cap-node-ripple r-1" />
                      <circle r="4.5" class="cap-node-outer" />
                      <circle r="2" class="cap-node-center" />
                    </g>

                    <!-- Node 2 (Handle 1) -->
                    <g class="cap-node-point np-2" transform="translate(68, 16)">
                      <circle r="7" class="cap-node-ripple r-2" />
                      <circle r="3.5" class="cap-node-handle" />
                      <circle r="1.5" class="cap-node-center" />
                    </g>

                    <!-- Node 3 (Handle 2) -->
                    <g class="cap-node-point np-3" transform="translate(152, 54)">
                      <circle r="7" class="cap-node-ripple r-3" />
                      <circle r="3.5" class="cap-node-handle" />
                      <circle r="1.5" class="cap-node-center" />
                    </g>

                    <!-- Node 4 (Target UI Anchor) -->
                    <g class="cap-node-point np-4" transform="translate(200, 18)">
                      <circle r="9" class="cap-node-ripple r-4" />
                      <circle r="4.5" class="cap-node-outer" />
                      <circle r="2" class="cap-node-center" />
                    </g>

                    <!-- Traveling Light Spark / UX Cursor Follower -->
                    <circle r="3.2" class="cap-traveling-orb">
                      <animateMotion path="M 20 52 C 70 14, 150 56, 200 18" dur="2.8s" repeatCount="indefinite" />
                    </circle>
                  </svg>

                  <!-- Mini UI Wireframe Cards -->
                  <div class="cap-ghost-card gc-1">
                    <div class="mini-ui-dots"><span class="m-dot red"></span><span class="m-dot yellow"></span><span class="m-dot green"></span></div>
                    <div class="mini-ui-line line-1"></div>
                    <div class="mini-ui-line line-2"></div>
                  </div>
                  <div class="cap-ghost-card gc-2">
                    <div class="mini-ui-top"><span class="mini-ui-chip">UI / UX</span></div>
                    <div class="mini-ui-toggle"><span class="m-thumb"></span></div>
                  </div>
                </div>
              </div>

              <p class="cap-desc">Interfaces, tactile interactions, and design systems made to feel obvious and memorable.</p>

              <div class="cap-tags">
                <span>Mental Models</span>
                <span>Design Systems</span>
                <span>Prototypes</span>
              </div>

              <div class="cap-footer">
                <a href="services.html" class="cap-action-link">
                  <span class="cap-action-label">Explore capability</span>
                  <span class="cap-action-arrow">↗</span>
                </a>
              </div>
            </div>
          </div>
        </div>

        <!-- 02 / Creative Technology -->
        <div class="capability-card-interactive" data-capability="creative" data-cursor="CREATIVE">
          <div class="cap-glare"></div>
          <button class="cap-accordion-toggle" aria-expanded="false" aria-controls="cap-content-2" id="cap-header-2">
            <div class="cap-header-info">
              <span class="cap-num">02</span>
              <h3 class="cap-title">Creative Technology</h3>
            </div>
            <div class="cap-header-meta">
              <div class="cap-live-badge">
                <span class="cap-badge-pulse pulse-blue"></span>
                <span class="cap-badge-text">3D SHADERS</span>
              </div>
              <span class="cap-accordion-icon" aria-hidden="true">+</span>
            </div>
          </button>

          <div class="cap-expandable-content" id="cap-content-2" role="region" aria-labelledby="cap-header-2">
            <div class="cap-content-inner">
              <div class="cap-micro-stage">
                <div class="cap-particles-art">
                  <div class="cap-ring cr-1"></div>
                  <div class="cap-ring cr-2"></div>
                  <div class="cap-ring cr-3"></div>
                  <div class="cap-core-sparkle">✦</div>
                </div>
              </div>

              <p class="cap-desc">WebGL, 3D scenes, custom shaders, and expressive playful interfaces that reward exploration.</p>

              <div class="cap-tags">
                <span>WebGL / Three.js</span>
                <span>Custom Shaders</span>
                <span>60fps Motion</span>
              </div>

              <div class="cap-footer">
                <a href="services.html" class="cap-action-link">
                  <span class="cap-action-label">Explore capability</span>
                  <span class="cap-action-arrow">↗</span>
                </a>
              </div>
            </div>
          </div>
        </div>

        <!-- 03 / Product Engineering -->
        <div class="capability-card-interactive" data-capability="engineering" data-cursor="ENGINEER">
          <div class="cap-glare"></div>
          <button class="cap-accordion-toggle" aria-expanded="false" aria-controls="cap-content-3" id="cap-header-3">
            <div class="cap-header-info">
              <span class="cap-num">03</span>
              <h3 class="cap-title">Product Engineering</h3>
            </div>
            <div class="cap-header-meta">
              <div class="cap-live-badge">
                <span class="cap-badge-pulse pulse-green"></span>
                <span class="cap-badge-text">HIGH PERF</span>
              </div>
              <span class="cap-accordion-icon" aria-hidden="true">+</span>
            </div>
          </button>

          <div class="cap-expandable-content" id="cap-content-3" role="region" aria-labelledby="cap-header-3">
            <div class="cap-content-inner">
              <div class="cap-micro-stage">
                <div class="cap-code-art">
                  <div class="cap-code-row"><span class="cc-kw">const</span> <span class="cc-var">app</span> = <span class="cc-fn">renderSpatial</span>();</div>
                  <div class="cap-code-row"><span class="cc-kw">await</span> <span class="cc-var">cluster</span>.<span class="cc-fn">deploy</span>(<span class="cc-str">'edge'</span>);</div>
                  <div class="cap-code-row cc-highlight"><span class="cc-ok">✓ 100% Score</span> <span class="cc-cursor"></span></div>
                </div>
              </div>

              <p class="cap-desc">Fast, responsive frontends and resilient cloud systems built around real user needs.</p>

              <div class="cap-tags">
                <span>Next.js / Vite</span>
                <span>Scalable APIs</span>
                <span>Edge Infrastructure</span>
              </div>

              <div class="cap-footer">
                <a href="services.html" class="cap-action-link">
                  <span class="cap-action-label">Explore capability</span>
                  <span class="cap-action-arrow">↗</span>
                </a>
              </div>
            </div>
          </div>
        </div>

        <!-- 04 / AI & Automation -->
        <div class="capability-card-interactive" data-capability="ai" data-cursor="AI WORKFLOW">
          <div class="cap-glare"></div>
          <button class="cap-accordion-toggle" aria-expanded="false" aria-controls="cap-content-4" id="cap-header-4">
            <div class="cap-header-info">
              <span class="cap-num">04</span>
              <h3 class="cap-title">AI & Automation</h3>
            </div>
            <div class="cap-header-meta">
              <div class="cap-live-badge">
                <span class="cap-badge-pulse pulse-purple"></span>
                <span class="cap-badge-text">AI AGENTS</span>
              </div>
              <span class="cap-accordion-icon" aria-hidden="true">+</span>
            </div>
          </button>

          <div class="cap-expandable-content" id="cap-content-4" role="region" aria-labelledby="cap-header-4">
            <div class="cap-content-inner">
              <div class="cap-micro-stage">
                <div class="cap-synapse-art">
                  <div class="cap-syn-core"></div>
                  <div class="cap-syn-orbit so-1"></div>
                  <div class="cap-syn-orbit so-2"></div>
                  <div class="cap-syn-node n-1"></div>
                  <div class="cap-syn-node n-2"></div>
                  <div class="cap-syn-node n-3"></div>
                </div>
              </div>

              <p class="cap-desc">Practical AI layers, intelligent multi-agent workflows, and assistants that create leverage.</p>

              <div class="cap-tags">
                <span>Agent Workflows</span>
                <span>Vector RAG</span>
                <span>LLM Tooling</span>
              </div>

              <div class="cap-footer">
                <a href="services.html" class="cap-action-link">
                  <span class="cap-action-label">Explore capability</span>
                  <span class="cap-action-arrow">↗</span>
                </a>
              </div>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <section class="section shell work-preview">
    <div class="section-head reveal"><div><div class="section-kicker">02 / SELECTED WORK</div><h2 class="section-title compact">A few things we've <span class="gradient-text">made move.</span></h2></div><a class="text-link" href="work.html" data-cursor="ALL WORK">See all work <span>→</span></a></div>
    <div class="project-grid">
      <div class="project-card large reveal" data-project="orbit" data-cursor="OPEN" data-cursor-text="VIEW PROJECT">
        <div class="project-card-inner">
          <div class="card-glare"></div>
          <div class="project-art art-orbit">
            <div class="scene-orbit" id="orbitScene">
              <div class="orbit-glow"></div>
              <svg class="orbit-svg" viewBox="0 0 300 300" aria-hidden="true">
                <ellipse class="orbit-path" cx="150" cy="150" rx="110" ry="44" />
                <line class="orbit-connector" x1="75" y1="135" x2="225" y2="165" />
                <circle class="orbit-satellite sat-1" cx="75" cy="135" r="7" />
                <circle class="orbit-satellite sat-2" cx="225" cy="165" r="7" />
              </svg>
              <div class="orbit-core"><div class="orbit-core-pulse"></div></div>
            </div>
            <div class="project-chip">PRODUCT / 2026</div>
            <div class="project-word">ORBIT</div>
            <div class="project-hover-badge"><span>VIEW</span> ↗</div>
          </div>
          <div class="project-meta">
            <div>
              <h3>Orbit Logistics</h3>
              <p>Operations platform</p>
            </div>
            <span class="meta-arrow">↗</span>
          </div>
        </div>
      </div>

      <div class="project-card reveal delay-1" data-project="nova" data-cursor="OPEN" data-cursor-text="VIEW PROJECT">
        <div class="project-card-inner">
          <div class="card-glare"></div>
          <div class="project-art art-nova">
            <div class="scene-nova" id="novaScene">
              <div class="nova-grid"></div>
              <div class="nova-sphere"></div>
              <div class="nova-rings"></div>
              <div class="nova-coords"><span>LAT: 47.32°</span><span>LNG: -122.18°</span></div>
            </div>
            <div class="project-chip">3D / WEBGL</div>
            <div class="project-word">NOVA</div>
            <div class="project-hover-badge"><span>VIEW</span> ↗</div>
          </div>
          <div class="project-meta">
            <div>
              <h3>Nova Spaces</h3>
              <p>Interactive launch site</p>
            </div>
            <span class="meta-arrow">↗</span>
          </div>
        </div>
      </div>

      <div class="project-card reveal delay-2" data-project="loop" data-cursor="OPEN" data-cursor-text="VIEW PROJECT">
        <div class="project-card-inner">
          <div class="card-glare"></div>
          <div class="project-art art-loop">
            <div class="scene-loop" id="loopScene">
              <canvas class="loop-wave-canvas" width="280" height="240"></canvas>
              <div class="loop-symbol">∞</div>
              <div class="loop-nodes">
                <span class="l-node n1"></span><span class="l-node n2"></span><span class="l-node n3"></span>
              </div>
            </div>
            <div class="project-chip">AI / PLATFORM</div>
            <div class="project-word">LOOP</div>
            <div class="project-hover-badge"><span>VIEW</span> ↗</div>
          </div>
          <div class="project-meta">
            <div>
              <h3>Loop Intelligence</h3>
              <p>AI workflow system</p>
            </div>
            <span class="meta-arrow">↗</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Kinetic Typographic Scroll Section -->
  <section class="kinetic-statement-section" id="kineticStatementSection">
    <div class="kinetic-sticky-stage" id="kineticStickyStage">
      <div class="kinetic-bg-grid"></div>
      <div class="kinetic-glow" id="kineticGlow"></div>
      
      <div class="kinetic-inner shell">
        <div class="kinetic-meta-top">
          <span class="kinetic-kicker">03 / MANIFESTO</span>
          <span class="kinetic-coords">DESIGN × CODE × CURIOSITY</span>
        </div>
        
        <div class="kinetic-type-box" id="kineticTypeBox">
          <!-- Line 1: BRINGING YOUR (compresses tightly) -->
          <div class="kinetic-line kinetic-line-compress line-we-build" id="kLineWeBuild">
            <span class="k-word word-we">BRINGING</span>
            <span class="k-word word-build">YOUR</span>
          </div>
          
          <!-- Line 2: DIGITAL VISION (expands across screen) -->
          <div class="kinetic-line kinetic-line-expand line-digital" id="kLineDigital">
            <span class="k-word word-digital gradient-text">DIGITAL VISION</span>
          </div>
          
          <!-- Line 3: TO LIFE (moves horizontally) -->
          <div class="kinetic-line kinetic-line-drift line-experiences" id="kLineExperiences">
            <div class="experiences-track kinetic-drift-track" id="experiencesTrack">
              <span class="k-word word-experiences">TO LIFE</span>
              <span class="k-spark">✦</span>
              <span class="k-word word-sub">DESIGN × CODE × CURIOSITY</span>
              <span class="k-spark">✦</span>
              <span class="k-word word-repeat">TO LIFE</span>
            </div>
          </div>
        </div>
        
        <div class="kinetic-meta-bottom">
          <div class="kinetic-meter">
            <span class="meter-text">MANIFESTO CADENCE</span>
            <div class="meter-track">
              <div class="meter-bar" id="kineticMeterBar"></div>
            </div>
          </div>
          <span class="kinetic-tagline">“Bringing your digital vision to life.”</span>
        </div>
      </div>
    </div>
  </section>

  <section class="section shell final-cta">
    <div class="cta-panel reveal">
      <div class="section-kicker">03 / NEXT MOVE</div>
      <h2>Have a problem worth <span class="gradient-text">solving?</span></h2>
      <a class="button primary" href="contact.html" data-cursor="LET'S TALK" data-magnetic="true">Start a conversation <span>↗</span></a>
    </div>
  </section>
</main>

<!-- Fullscreen Project Showcase Transition Modal -->
<div id="projectModal" class="project-modal" aria-hidden="true" role="dialog" aria-modal="true">
  <div class="project-modal-backdrop" id="modalBackdrop"></div>
  <div class="project-modal-sheet" id="modalSheet">
    <button class="project-modal-close" id="modalClose" aria-label="Close project showcase" data-cursor="CLOSE">✕</button>
    <div class="project-modal-scroll">
      <div class="project-modal-hero" id="modalHero">
        <div class="modal-hero-art" id="modalHeroArt"></div>
        <div class="modal-hero-overlay">
          <div class="modal-chip" id="modalChip">PRODUCT / 2026</div>
          <h1 class="modal-title" id="modalTitle">Orbit Logistics</h1>
          <p class="modal-subtitle" id="modalSubtitle">Global freight intelligence and real-time fleet coordination platform.</p>
        </div>
      </div>
      
      <div class="project-modal-body shell">
        <div class="modal-grid">
          <div class="modal-main">
